# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x4010.
0x4010   # INIT

# La interrupcion: INIT pone un "jp 0x406B" en el gancho H.KEYI (0xFD9A), 0x402A-0x4035.
0x406B

# Las 23 tareas con cuenta atras: la interrupcion mira 23 cuentas desde 0xEC2D y, cuando una llega a 0, salta a la
# rutina de su numero en la tabla 0x40B7 (0x4096: "ld hl,0x40B7 / ... / jp (hl)").
