0x6E82


# El estado siguiente que se guarda en 0xE217 y pasa a 0xE09A en 0x4813 ("ld hl,(0xE217) / ld (0xE09A),hl"):
# 0x40E5 o 0x42EF (0x4153).
0x42EF

# Otro estado de 0xE09A, puesto con un "jr" en medio (0x62ED: "ld hl,0x62FD / ... / ld (0xE09A),hl").
0x62FD

# Otro estado, guardado con DE (0x56A1: "ld de,0x675F / ld (0xE09A),de"): el final del mapa.
0x675F
