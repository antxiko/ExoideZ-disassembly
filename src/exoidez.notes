D 0x5384 0x53EA ronda2_datos        Las casillas de la ronda 2 y sus colores
L 0x53EA ronda3_casillas           Las de la ronda 3: 0x53F8 y sus colores (0x5415)
D 0x53F8 0x5458 ronda3_datos        Las casillas de la ronda 3 y sus colores
# EL SCROLL: dos tablas de nombres (0x1800 y 0x1C00) y dos copias del fondo en la RAM (0xE44D y 0xE76D): mientras
# una se ensena (el registro 2), la otra se rellena por tercios; cada 12 pasos (0xE425) se cambian.
L 0x5458 scroll_pon                El scroll al empezar: se ensena la tabla 0x1800 (0xE092 = 0x18, 0xE094 = 0x1C), las dos copias de la RAM (0xE44D y 0xE76D) y el registro 2 = 6
C 0x5458 la que se ensena: 0x1800...
C 0x545D ...y la otra, 0x1C00
C 0x5462 la copia que se ensena...
C 0x546B ...y la otra
C 0x5471 el registro 2: 7 (0x1C00)...
C 0x5476 ...y 6 (0x1800), el de ahora
C 0x547D WRTVDP
L 0x5480 fondo_pon                 El fondo de la ronda: 0xE00F (3 bytes de 0xE267), las casillas de la estacion, la RAM del scroll a cero (0xE42D, 0x640 bytes), el primer trozo del mapa y las dos tablas de nombres; despues el mapa siguiente (0xE0BD) segun las vidas perdidas
C 0x5480 de 0xE267...
C 0x5483 ...a 0xE00F...
C 0x5486 ...3 bytes
C 0x548B las casillas de la estacion
C 0x548E el paso del scroll a 0
C 0x5492 el desplazamiento de casilla a 0
C 0x5495 0xEB6E a 0
C 0x5498 0xE422 = 0xFF
C 0x549C 8 filas por trozo
C 0x54A1 0x2C0: la fila 22 de la copia
C 0x54A7 la RAM del scroll...
C 0x54AA ...0x640 bytes...
C 0x54AD ...a cero
C 0x54B2 el primer trozo
C 0x54B5 la tabla de nombres
C 0x54B8 y la otra
C 0x54BB el mapa de la ronda...
C 0x54BF ...y las vidas perdidas en ella (0xE0BC)
C 0x54C9 ninguna: el mapa de 0xE0BF
C 0x54CC tres o mas: el otro (0xE0C1)
C 0x54D0 una o dos: el otro si el mapa lo dice (bit 7)
L 0x54D4 fondo_mapa_otro
L 0x54D5 fondo_mapa
C 0x54D5 el mapa
L 0x54D9 tarea_scroll              La tarea 0, cada cuadro: un tercio de la tabla de nombres escondida (el paso 0xE425: 0, 3, 6, 9 el primero; 1, 4, 7, 10 el segundo; el tercero en los otros) desde la copia, con el desplazamiento 0xEA6D; en los pasos 2, 5, 8 y 11, se cambia de tabla
C 0x54D9 otra vez en el cuadro siguiente
C 0x54DE el paso
C 0x54E1 el primer tercio
C 0x54F4 el segundo
C 0x5507 el tercero
L 0x550A scroll_tercio
C 0x550A la tabla escondida + el tercio
C 0x550E SETWRT
C 0x5511 la copia + el tercio
C 0x5515 el desplazamiento de casilla
C 0x5519 256 casillas
L 0x551B scroll_casilla
C 0x551C + el desplazamiento
C 0x551D a la VRAM
C 0x5522 el paso 2, 5, 8 u 11?
L 0x5534 scroll_cambia
C 0x5534 se cambia de tabla
C 0x5537 0xEB6E = 2: quieto
C 0x553D si no, el desplazamiento uno mas
L 0x5545 tablas_cambia             Se cambian la tabla que se ensena y la escondida (0xE092/0xE094) y los valores del registro 2 (0xE095/0xE096), y el registro 2
C 0x5557 el registro 2
L 0x555C cambia                    (HL) y (DE) se cambian
L 0x5562 tarea_mapa                La tarea 6: cada cuadro, 0x40 bytes de la copia que se ensena a la escondida, una fila mas arriba (el scroll); cada 12 pasos se cambian las copias y entran 32 casillas nuevas del mapa (contando las 0xC8 en 0xE0B3)
C 0x5562 otra vez en el cuadro siguiente
C 0x5567 la copia escondida...
C 0x556A ...+ la posicion
C 0x5576 la que se ensena...
C 0x557B 0x40 bytes
C 0x557E quieto (0xEB6E = 2)?
L 0x5587 tarea_mapa_paso
C 0x5587 la posicion, dos filas arriba
C 0x5593 el paso siguiente
C 0x559A el 12?
C 0x559D el paso a 0
C 0x55A4 quieto?
C 0x55AB se cambian las copias
L 0x55B9 tarea_mapa_nuevo          Un trozo nuevo: 32 casillas del trozo del mapa (0xE427) en la fila de arriba de la copia
C 0x55B9 la posicion, otra vez a la fila 22
C 0x55BF 0xE422?
C 0x55C4 la fila de arriba de la copia
C 0x55CE el trozo del mapa
C 0x55D7 32 casillas
C 0x55D8 0xC8: las que se cuentan
