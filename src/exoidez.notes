# EXOIDE-Z (Casio, 1986) - anotaciones
# EXOIDE-Z (Casio, 1986) - anotaciones
#
# LA ROM: 16 KB en la pagina 1 (0x4000-0x7FFF). La cabecera es "AB" e INIT (0x4010); el resto, a cero.
#
# LA INTERRUPCION va por el gancho H.KEYI (0xFD9A): INIT pone alli un "jp 0x406B". El bucle principal es un
# "jr $" (0x4043): todo el juego corre en la interrupcion, que llama al estado de 0xE09A y lleva 23 tareas con
# cuenta atras (0xEC2D, tabla 0x40B7).
#
# LA PANTALLA: SCREEN 2 con dos tablas de nombres (0x1800 y 0x1C00) y los atributos de los sprites en 0x1F80.
L 0x4010 init                      El arranque: sin interrupciones, H.TIMI con un "ret", la RAM 0xE091-0xEDFF a cero, la pila, la pantalla y los dibujos (0x7834), H.KEYI a 0x406B, el primer estado (0x40E5) y el bucle vacio
C 0x4010 sin interrupciones
C 0x4011 un "ret"...
C 0x4013 ...en H.TIMI (0xFD9F)
C 0x4016 0xE091...
C 0x4019 ...0xE092...
C 0x401C ...0xD6F bytes...
C 0x401F ...a cero
C 0x4023 la pila
C 0x4026 la pantalla y los dibujos
C 0x402A H.KEYI (0xFD9A)...
C 0x402D ...la interrupcion, 0x406B...
C 0x4030 ...con su "jp"
C 0x4036 el primer estado: la presentacion (0x40E5)
C 0x403C la fila 0 del teclado...
C 0x403D SNSMAT
C 0x4040 ...en 0xE097
L 0x4043 bucle_vacio               El bucle principal: nada; todo va en la interrupcion
C 0x4043 para siempre
L 0x4045 partida_borra             Una partida nueva: 0xE0A8-0xE0CA a cero y 0xE0A9 (las vidas) = 2
C 0x4045 desde 0xE0A8...
C 0x4048 ...35 bytes...
C 0x404B ...a cero
C 0x404F dos vidas de reserva
L 0x4055 desempaqueta              Desempaqueta B bloques de HL a DE: cada bloque, un byte de mascara y 8 bytes; un bit a 1 lee un byte nuevo, a 0 repite el anterior (A')
C 0x4055 los bloques
C 0x4056 la mascara
C 0x4059 el ultimo byte, de A'
C 0x405A ocho bytes
L 0x405C desempaqueta_bit
C 0x405C el bit de arriba
C 0x405E 0: el mismo
C 0x4060 1: uno nuevo
L 0x4062 desempaqueta_pon
C 0x4062 a DE
C 0x4066 el ultimo, a A'
L 0x406B interrupcion              La interrupcion (H.KEYI): la del VDP cortada mientras dura (registro 1 sin el bit 5), el estado de 0xE09A, las 23 tareas con cuenta atras y el registro 1 de vuelta
C 0x406B lee el estado del VDP (la interrupcion atendida)
C 0x406D el registro 1...
C 0x4070 ...sin la interrupcion del VDP
C 0x4075 WRTVDP
C 0x4078 el estado...
C 0x407B ...se llama
C 0x407E las 23 cuentas de las tareas
L 0x4083 interrupcion_tarea
C 0x4083 una cuenta
C 0x4085 0: parada
C 0x4087 una menos
C 0x4089 aun no
C 0x408D a 0: su tarea
L 0x4092 interrupcion_sig
C 0x4095 el estado del VDP
C 0x4097 y el registro 1 como estaba
C 0x409D WRTVDP
L 0x40A0 tarea                     La tarea 23 - B de la tabla 0x40B7
C 0x40A0 la tabla
C 0x40A3 23 - B...
C 0x40A6 ...x 2
L 0x40AF salta_hl                  jp (hl): el estado o la tarea
L 0x40B0 estado_nada               El estado vacio: 0xE09A = 0x40B6, un "ret"
L 0x40B6 nada
D 0x40B7 0x40E5 tabla_tareas        Las 23 tareas con cuenta atras (0xEC2D-0xEC43): cuando la cuenta de una llega a 0, la interrupcion salta aqui
F 0x40B7 w8
L 0x7748 sprites_y_espejo          B sprites de 16 x 16 de DE a la VRAM (SETWRT antes), y detras su espejo (los bits de cada byte al reves, en 0xED10)
C 0x7749 el espejo, en 0xED10
C 0x774C 16 bytes
L 0x774E sprite_byte
C 0x774F un byte...
C 0x7750 ...a la VRAM
C 0x7752 sus 8 bits...
L 0x7754 sprite_espejo_bit
C 0x7754 ...al reves...
C 0x7755 ...en (HL)
C 0x775E y el espejo detras
C 0x7763 a la VRAM
L 0x776A sprites_32_espejo         B sprites de 32 bytes (las dos mitades cambiadas en el espejo: 0xED20 la izquierda, 0xED10 la derecha)
C 0x776B la mitad de la izquierda del espejo
L 0x7770 sprite32_izq
L 0x777C sprite32_der
C 0x7777 la otra mitad
C 0x7783 los 32 bytes del espejo...
C 0x7788 ...a la VRAM
L 0x778F sprite_un_byte            Un byte de DE a la VRAM y al reves en (HL)
C 0x778F un byte...
C 0x7790 ...a la VRAM
C 0x7792 sus 8 bits...
L 0x7794 sprite_un_byte_bit
C 0x7795 ...al reves
L 0x779C sprites_volteados         Como 0x776A, y ademas las dos copias de arriba abajo (0x7939 lee hacia atras)
L 0x77A3 volteado_izq
L 0x77AF volteado_der
C 0x77B6 la izquierda, de abajo arriba
C 0x77BE la derecha, de abajo arriba
C 0x77C6 el espejo
C 0x77CF el original...
C 0x77D1 ...de abajo arriba
L 0x77E8 mandos                    La palanca (GTSTCK) en E y el boton (GTTRIG, solo el bit 0) en D, del mando de 0xE098 (0 el teclado, 1 el mando 1)
C 0x77E8 el teclado o el mando
C 0x77EB GTSTCK
C 0x77F3 GTTRIG
C 0x77F7 pulsado: 1
L 0x77FB tareas_paradas            Las 23 cuentas de las tareas (0xEC2D) a cero
L 0x7809 pantalla_borra            La pantalla en blanco: el sonido callado, las dos tablas de nombres (0x1800 y 0x1C00) a 0 y los sprites fuera (0x1F80, Y = 0xE0)
C 0x7809 el sonido callado
C 0x780C la tabla de nombres 0x1800...
C 0x7813 FILVRM
C 0x7816 ...y la 0x1C00
C 0x7820 los 32 sprites...
C 0x7826 ...con la Y 0xE0
L 0x782B llena                     BC bytes de A desde HL
C 0x782B el byte
L 0x782C llena_byte
L 0x7834 pantalla_pon              La pantalla del juego: los registros del VDP (0x7907), la VRAM a cero, la RAM 0xE091-0xE890 a cero, los dibujos de los sprites (con sus espejos) y algunos de las casillas, el estado vacio, la interrupcion del VDP y 40 bloques desempaquetados a 0xE0D1
C 0x7834 los registros del VDP
C 0x7837 DISSCR
C 0x783A toda la VRAM...
C 0x7841 ...a cero
C 0x7844 la RAM...
C 0x784D ...a cero
C 0x7851 los sprites fuera
C 0x785C los dibujos de los sprites desde 0x3800
C 0x7862 ocho, de 0x794D, con su espejo
C 0x786A 0xA0 bytes de 0x7A8D...
C 0x786D ...a 0x3EA0
C 0x7876 y desde 0x3B60...
C 0x787C ...0x40 bytes de 0x7B2D...
C 0x7884 ...y trozos de 8 bytes
C 0x78BF el estado vacio
C 0x78C2 el registro 1 con la interrupcion del VDP (0xE2)
C 0x78C7 el sonido callado
C 0x78CA 40 bloques de 0x4709...
C 0x78CD ...desempaquetados a 0xE0D1
C 0x78D5 ENASCR
L 0x78D8 sprites_3c00              Mas dibujos de sprites desde 0x3C00: seis con espejo (0x79CD), dos de 32 bytes (0x7A2D) y uno volteado (0x7A6D)
L 0x78F6 vdp_registros             Los 8 registros del VDP de la tabla 0x7907
C 0x78F6 la tabla
C 0x78F9 8 registros, desde el 0
L 0x78FC vdp_registro
C 0x78FD el valor
C 0x78FE WRTVDP
D 0x7907 0x790F vdp_tabla           SCREEN 2: R0 = 2, R1 = 0xE2 (16 KB, pantalla e interrupcion, sprites de 16 x 16), nombres 0x1800, colores 0x2000, dibujos 0x0000, atributos de los sprites 0x1F80, sus dibujos 0x3800, el fondo negro
L 0x790F letras_vram               B letras de DE en la VRAM desde HL: cada una, los 8 bytes de la fuente de la BIOS (CGTABL, 0x0004)
C 0x790F SETWRT
L 0x7912 letra
C 0x7913 la letra
C 0x7915 la fuente de la BIOS
C 0x791A x 8
L 0x792C vram8                     8 bytes de HL a la VRAM
L 0x792E vram_b                    B bytes de HL a la VRAM (con una espera entre uno y otro)
C 0x792E espera: el VDP necesita tiempo
C 0x7932 un byte...
C 0x7933 ...al puerto de datos
L 0x7939 vram_b_atras              B bytes a la VRAM leyendo HL hacia atras
C 0x793D un byte
L 0x7944 vram_relleno              B veces A en la VRAM
C 0x7944 espera
C 0x7948 A al puerto de datos
D 0x794D 0x7B8D sprites_casillas    Dibujos de sprites (los de 0x7834 y 0x78D8) y de casillas, en bytes
C 0x78BC la pieza de la RAM (0x7FAE)
L 0x7B8D sonido_calla              El PSG callado: los registros 13 a 0 a cero y el 7 (la mezcla) a 0xB8
C 0x7B8D 14 registros
C 0x7B8F a 0
L 0x7B91 sonido_calla_reg
C 0x7B91 el registro B - 1
C 0x7B93 WRTPSG
C 0x7B98 la mezcla: tono en A, B y C, sin ruido
D 0x7B9F 0x7BA7 codigo_7b9f         "call 0x7BA7 / call 0x7BAB / jr...": tres instrucciones a las que no salta nadie
L 0x7BA7 canal_a_calla             El volumen del canal A (registro 8) a 0
L 0x7BAB canal_b_calla             El del canal B (9)
L 0x7BAF canal_c_calla             El del canal C (10)
L 0x7BB1 psg_cero
C 0x7BB1 el valor 0
L 0x7BB5 efecto_a                  Un efecto en el canal A (0xE3D5 = A con el bit 7): 0 y 1 con ruido (periodo de 0x7CA6/0x7CA8), 2 un tono que baja (0x7CAA), 3 ruido (0x7CAE)
C 0x7BB5 empezado
C 0x7BBA el 0
C 0x7BC1 el 1
C 0x7BC8 el 2: tono
C 0x7BD0 el 3
C 0x7BD3 otro: nada
L 0x7BD6 efecto_a_ruido            Con ruido: el tono del canal A callado, la mezcla con ruido en A (0xB0) y su periodo (registro 6)
C 0x7BD6 el tono a 0
C 0x7BD9 la mezcla...
C 0x7BDB ...ruido en el canal A
C 0x7BE0 el periodo del ruido...
C 0x7BE5 ...registro 6
L 0x7BEA efecto_a_volumen          El volumen 15 (0xE3D6) y la cuenta del paso siguiente (0xE3D7)
C 0x7BEA volumen 15
C 0x7BEF al registro 8
L 0x7BF2 efecto_a_cuenta
C 0x7BF3 cada cuantos cuadros
L 0x7BF8 canal_a_tono0             El tono del canal A (registros 0 y 1) a 0
C 0x7BF8 el registro 0
C 0x7BFD el 1
L 0x7C03 canal_a_volumen           El volumen del canal A (registro 8) = A
L 0x7C06 psg                       WRTPSG
L 0x7C09 efecto_a_tono             El 2: un tono (dos bytes, 0xE3D9 y 0xE3DA), sin ruido, volumen 15 y cuanto baja (0xE3D8)
C 0x7C09 el tono, bajo...
C 0x7C13 ...y alto
C 0x7C1D la mezcla sin ruido
C 0x7C24 volumen 15
C 0x7C27 cuanto baja el tono cada paso
L 0x7C2C tarea_efecto_a            La tarea 18 (0x40B7): un paso del efecto del canal A: el volumen baja uno; en el 2, ademas, el tono; a 0, callado (0xE3D5 = 0x0F)
C 0x7C2C la cuenta de la tarea, a 1
C 0x7C31 ninguno?
C 0x7C37 uno nuevo: empieza
C 0x7C3F el 2?
C 0x7C43 4 o mas: nada
L 0x7C46 efecto_a_paso
C 0x7C46 el volumen
C 0x7C4A queda
L 0x7C4C efecto_a_fin               Acabado: 0xE3D5 = 0x0F y la mezcla sin ruido
C 0x7C4C ninguno
C 0x7C51 la mezcla de siempre
L 0x7C58 efecto_a_baja
C 0x7C58 un punto menos
C 0x7C5C al PSG
C 0x7C5F y la cuenta del paso siguiente
L 0x7C66 efecto_a_tono_baja        El 2: el tono, 0xE3D8 menos
C 0x7C6E el tono nuevo...
C 0x7C71 ...al PSG
L 0x7C76 efecto_a_corta            Corta el efecto del canal A si su volumen ya baja de 8
C 0x7C76 alguno?
C 0x7C80 volumen 8 o mas?
C 0x7C84 a 0 y acabado
L 0x7C8A efecto_a_corta_tono
C 0x7C8A al PSG
C 0x7C8E el de tono?
L 0x7C98 canal_a_tono              El tono del canal A: E el bajo (registro 0) y 0xE3DA el alto (1)
C 0x7C9A WRTPSG
C 0x7CA3 WRTPSG
D 0x7CA6 0x7CB0 efecto_a_datos      Los efectos del canal A: el periodo del ruido y la cuenta (0 y 1), el tono, la cuenta y lo que baja (2), el ruido (3)
L 0x7CB0 efecto_c                  Un efecto en el canal C (0xE3DB, con el bit 7 al empezar): tres, con tono, de la tabla 0x7D3D (4 bytes: el tono, cuanto baja, la cuenta)
C 0x7CB0 el pedido...
C 0x7CB4 ...empezado
C 0x7CB6 el 0
C 0x7CBC el 1
C 0x7CC2 el 2
L 0x7CC7 efecto_c_pon
C 0x7CC7 el tono, bajo...
C 0x7CCC ...registro 4
C 0x7CD2 ...y alto
C 0x7CD7 registro 5
C 0x7CDC volumen 15
C 0x7CE2 al registro 10
C 0x7CE6 cuanto baja
C 0x7CEB la cuenta del paso
L 0x7CF0 tarea_efecto_c            La tarea 20: un paso del efecto del canal C: el tono baja (0xE3DE) y el volumen uno; a 0, callado
C 0x7CF0 la cuenta de la tarea, a 1
C 0x7CF5 uno nuevo (sin el bit 7)?
C 0x7CFC 0xEC3E?
C 0x7D01 empieza
L 0x7D04 efecto_c_paso
C 0x7D07 0-2?
C 0x7D0C el tono...
C 0x7D14 ...menos lo que baja
C 0x7D17 registro 4
C 0x7D1E registro 5
C 0x7D23 el volumen
C 0x7D2A a 0: acabado
L 0x7D30 efecto_c_baja
C 0x7D30 uno menos
C 0x7D32 la cuenta del paso siguiente
L 0x7D38 canal_c_volumen           El volumen del canal C (registro 10) = E
D 0x7D3D 0x7D49 efecto_c_datos      Los tres efectos del canal C: el tono (dos bytes), cuanto baja y la cuenta de cada paso
L 0x7D49 musica                    La musica, en un canal (0xE404 su registro de volumen, 0xE405 el del tono): 0xE3E4 la pedida, 0xE3E5 la que suena; su lista de piezas desde (0xE407)
C 0x7D49 una pedida?
C 0x7D50 la que suena?
C 0x7D55 sigue
C 0x7D59 una nueva
C 0x7D5D el volumen: 12...
C 0x7D66 ...10 en la 2
L 0x7D68 musica_tempo
C 0x7D69 el tempo: 10 en la 1...
C 0x7D6F ...20 en la 3...
C 0x7D75 ...3 en las otras
L 0x7D77 musica_tempo_pon
L 0x7D7C musica_busca              La pieza B de la lista: se salta hasta su principio (las piezas acaban en 0x0000)
L 0x7D7F musica_busca_sig
L 0x7D83 musica_busca_dir
C 0x7D88 0x0000: el final de una
C 0x7D8D 0xFFFF?
L 0x7D92 musica_pieza
L 0x7D96 musica_pieza_va           Una pieza: por donde va (0xE3E6), sus notas (0xE3E8), la primera nota ya y las cuentas
C 0x7D96 la lista sigue aqui
C 0x7D9A las notas
C 0x7D9D la primera, ya
L 0x7DAE musica_cuadro             Un cuadro de la musica; acabada la pieza, la siguiente; con 0xFFFF, se acaba; con 0x0000, otra vez desde el principio
C 0x7DAE la nota
C 0x7DB1 aun suena
C 0x7DB2 la pieza siguiente
C 0x7DB9 0xFFFF: se acaba
C 0x7DBE 0x0000: vuelve a empezar
L 0x7DC8 musica_acaba
C 0x7DC8 ninguna pedida
L 0x7DCB musica_calla
C 0x7DCE el volumen del canal a 0
L 0x7DD6 musica_nota               Un cuadro de la nota: el volumen baja (0x7E38), y cuando acaba la duracion, la nota siguiente: (duracion, nota); la nota 0 calla, las otras son el tono de 0x7E51
C 0x7DD6 el volumen...
C 0x7DD9 RDPSG
C 0x7DDC ...baja?
C 0x7DE3 al PSG
L 0x7DE9 musica_nota_cuenta
C 0x7DE9 el tempo
C 0x7DF4 la duracion
C 0x7DF9 la nota siguiente
C 0x7DFE 0: el final de la pieza
C 0x7DFF la duracion
C 0x7E03 la nota
C 0x7E08 0: silencio
C 0x7E0C la tabla de tonos...
C 0x7E0F ...(nota - 1) x 2
C 0x7E15 el bajo...
C 0x7E19 WRTPSG
C 0x7E1D ...el alto
C 0x7E22 WRTPSG
C 0x7E25 el volumen
L 0x7E29 musica_volumen
C 0x7E2C WRTPSG
C 0x7E2F NZ: suena
L 0x7E33 musica_silencio
L 0x7E38 musica_baja               Cada tantos cuadros (0xE3E2) el volumen A baja uno
C 0x7E3A la cuenta
C 0x7E45 otra vez
C 0x7E4B uno menos
L 0x7E4D musica_baja_va
D 0x7E51 0x7E99 tonos               Los periodos del tono de las 36 notas (0x357 la mas grave ... 0x71)
F 0x7E51 w12
D 0x7E99 0x7FAA musicas_datos       Las listas de piezas (0x0000 al final de cada pieza, 0xFFFF al final) y las notas: parejas (duracion, nota)
D 0x7FAA 0x7FAE redoble_notas       Las cuatro notas (5, 3, 1, 3) de los cuatro grupos de 0x7FAE
L 0x7FAE redoble_pon               Una pieza de musica hecha en la RAM (0xE000): cuatro grupos de 18 notas de un cuadro (duracion 1, la nota de 0x7FAA) y el 0 del final; la lista 0x7FC7 la toca
C 0x7FAE las cuatro notas
C 0x7FB1 desde 0xE000
C 0x7FB4 cuatro grupos
C 0x7FB7 de 18
C 0x7FB9 la nota del grupo
L 0x7FBB redoble_nota
C 0x7FBB duracion 1...
C 0x7FBE ...y la nota
C 0x7FC5 0: el final de la pieza
D 0x7FC7 0x8000 musica_lista2       La lista de piezas de la segunda voz (0x7FC7: 0x7FD3, 0x7F2D... y 0xE000, la pieza de la RAM), mas notas y el final del cartucho a 0xFF
L 0x40E5 presentacion              La presentacion: la pantalla en blanco, los dibujos de las casillas (0x43CD), y cuatro CASIO que entran por los lados y por arriba y abajo hasta juntarse en el centro (0xE211 de 1 a 20, un paso cada 3 cuadros)
C 0x40E5 0xE0CE = 0
C 0x40E9 0xE0CD = 4
C 0x40EE DISSCR
C 0x40F1 0x5458
C 0x40F4 la pantalla en blanco
C 0x40F7 las tareas paradas
C 0x40FA los dibujos de las casillas
C 0x40FD el paso 1
C 0x4102 cada 3 cuadros
C 0x4107 la linea que baja (fila 0, columna 12)...
C 0x410D ...y la que sube (fila 23)
C 0x4113 el estado siguiente: 0x411C
C 0x4119 ENASCR
L 0x411C presentacion_cuadro       Cada 3 cuadros un paso: los dos CASIO de los lados y, desde el 9, los de arriba y abajo; al 21, la musica y la espera
C 0x411C la cuenta...
C 0x4121 ...otra vez 3
C 0x4123 los de arriba y abajo
C 0x4126 los de los lados
C 0x4129 un paso mas
C 0x412E el 21?
C 0x4132 desde el 9...
C 0x4135 ...la linea de arriba baja una fila...
C 0x413F ...y la de abajo sube
L 0x4148 presentacion_espera_pon   Juntos: 128 cuadros de espera (0xE09D), el estado 0x415E, despues el titulo (0x42EF, en 0xE217) y 13 cuadros del sonido de CASIO (0xE0CC)
C 0x4148 128 cuadros
C 0x414D el estado siguiente
C 0x4153 y despues, el titulo
C 0x4159 13 cuadros de sonido
L 0x415E presentacion_espera       La espera: el sonido de CASIO (los 13 registros del PSG de 0x4188 en el primer cuadro, el envolvente al ultimo) y, al acabar o con el boton, el titulo
C 0x415E el sonido
C 0x4162 acabado
C 0x4167 el ultimo cuadro?
C 0x4169 el primero?
C 0x416D los 13 registros del PSG...
C 0x4172 ...de 0x4188
L 0x4177 presentacion_sonido_fin
C 0x4177 el registro 4 (el tono del canal C)...
C 0x4179 ...a 0x20
L 0x417E presentacion_espera_va
C 0x417E la espera, un cuadro menos
C 0x4182 acabada: el titulo
C 0x4185 si no, el boton?
D 0x4188 0x41A2 sonido_casio        El sonido de CASIO: 13 parejas (registro del PSG, valor)
L 0x41A2 psg_tabla                 B parejas (registro, valor) de HL al PSG
C 0x41A2 el registro
C 0x41A4 el valor
C 0x41A6 WRTPSG
D 0x41AC 0x41BF logotipo_casio      Las dos filas del logotipo de CASIO: 0x41AD la de arriba y 0x41B6 la de abajo, nueve casillas cada una (0x70-0x7F), con un 0 delante y detras
L 0x41BF presentacion_lineas       Desde el paso 9: los CASIO de arriba y de abajo, cada uno con una fila en blanco (0x421B) detras, que bajan y suben hacia el centro
C 0x41BF el paso 9?
C 0x41C5 8 casillas
C 0x41C8 la fila de abajo...
C 0x41CB ...en la linea que baja
C 0x41CF LDIRVM
C 0x41D2 una fila arriba
C 0x41D9 la de arriba
C 0x41DF LDIRVM
C 0x41E9 y una en blanco encima
C 0x41F2 el CASIO que sube
C 0x41F5 la fila de arriba
C 0x41FC LDIRVM
C 0x41FF una fila abajo
C 0x4204 la de abajo
C 0x420A LDIRVM
C 0x4212 y una en blanco debajo
D 0x421B 0x4223 fila_blanco         Ocho casillas 0: la fila en blanco detras de los CASIO que suben y bajan
L 0x4223 presentacion_lados        Los dos CASIO de los lados en las filas 11 y 12: uno entra por la derecha casilla a casilla (tantas como el paso, 9 como mucho) y el otro por la izquierda, leido desde el final
C 0x4223 el paso
C 0x4227 9 como mucho
L 0x422D presentacion_lados_der
