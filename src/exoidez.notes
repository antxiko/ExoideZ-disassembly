C 0x5600 8 filas otra vez
C 0x5602 0xEB6E = 4?
C 0x5609 el trozo siguiente
C 0x5611 0xFF: el final
L 0x5615 mapa_trozo_pon            El trozo A: desempaquetado (1 n bytes, copia; 2 n v, n veces v; 0 acaba) en 0xEA6E, y su ultima fila en 0xEB4E
C 0x5615 se lee desde el final
C 0x561B su numero
C 0x561E el 6?
C 0x5622 el estado 0x75EE
C 0x5628 0xEB74 = 0x4F
