C 0x5669 un paso mas
C 0x5670 4: vacio
C 0x5675 2: el final
C 0x5679 1: el otro mapa
C 0x567C 0xEC32 a 0
C 0x5680 0xE2A6?
C 0x5686 la musica 4...
C 0x568B ...y la 3
L 0x568F mapa_otro
C 0x568F el mapa de 0x4AA5
L 0x5699 mapa_final
C 0x5699 0xEC30 a 0
C 0x569D 0xE2AB = 1
C 0x56A1 el estado 0x675F
