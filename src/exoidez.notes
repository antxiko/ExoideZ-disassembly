L 0x52C7 casillas_sueltas          Casillas de un color: (direccion de los colores, el color de las 8 de arriba, el de las 8 de abajo); 0 acaba
C 0x52C7 0: acaba
C 0x52CE la direccion
C 0x52D6 en el tercio
C 0x52DC el primer color, de la tabla de la ronda
C 0x52E4 8 filas
C 0x52E7 el segundo
L 0x52F4 color8                    El color A en 8 bytes (WRTVRM), saltando a la casilla de abajo cada 8
L 0x52F6 color8_byte
